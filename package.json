{
  "name": "car-music-player",
  "version": "1.0.0",
  "description": "车机版音乐播放器",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "expo build:android -t apk",
    "build:apk": "eas build --platform android --profile production",
    "build:apk-local": "expo run:android --variant release"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "expo": "~50.0.0",
    "expo-av": "~13.10.0",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-web": "~0.19.10",
    "react-dom": "18.2.0",
    "@expo/metro-runtime": "~3.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  }
}